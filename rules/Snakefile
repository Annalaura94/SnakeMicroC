# SnakeMicroC
# Reproducible Micro-C processing, QC and downstream structural analysis.

import os
WORKFLOW_BASEDIR = os.path.abspath(workflow.basedir)

# Support both:
#   - /path/to/SnakeMicroC/Snakefile
#   - /path/to/SnakeMicroC/rules/Snakefile
if os.path.exists(
    os.path.join(WORKFLOW_BASEDIR, "env", "processing.yaml")
):
    PIPELINE_DIR = WORKFLOW_BASEDIR
else:
    PIPELINE_DIR = os.path.abspath(
        os.path.join(WORKFLOW_BASEDIR, "..")
    )

if not os.path.exists(
    os.path.join(PIPELINE_DIR, "env", "processing.yaml")
):
    raise FileNotFoundError(
        "Cannot locate SnakeMicroC pipeline root from "
        f"workflow.basedir={workflow.basedir}"
    )

RESULTS = config.get("results_dir", "results")
TMPDIR = config["tmpdir"]

PROCESSING_ENV = os.path.join(PIPELINE_DIR, "env", "processing.yaml")
DOWNSTREAM_ENV = os.path.join(PIPELINE_DIR, "env", "downstream.yaml")
SCRIPTS = os.path.join(PIPELINE_DIR, "scripts")


R_ENV = os.path.join(PIPELINE_DIR, "env", "r.yaml")

CONTACT_RES = int(
    config["contacts"]["resolution"]
)

LOOP_RES = int(
    config["loops"]["primary_resolution"]
)

THREADS = int(
    config.get("processing", {}).get("threads", 8)
)

BALANCE_THREADS = int(
    config.get("contact_maps", {}).get(
        "balance_threads",
        config.get("processing", {}).get("balance_threads", 8)
    )
)

IGNORE_DIAGS = int(
    config.get("contact_maps", {}).get(
        "ignore_diags",
        config.get("processing", {}).get("ignore_diags", 2)
    )
)


SAMPLES = list(config["samples"].keys())

if len(SAMPLES) < 2:
    raise ValueError("At least two samples are required.")

CONDITIONS = [config["samples"][s]["condition"] for s in SAMPLES]

CONTROL_CONDITION = config["comparison"]["control_condition"]
TEST_CONDITION = config["comparison"]["test_condition"]

CONTROL_SAMPLES = [
    s for s in SAMPLES
    if config["samples"][s]["condition"] == CONTROL_CONDITION
]

TEST_SAMPLES = [
    s for s in SAMPLES
    if config["samples"][s]["condition"] == TEST_CONDITION
]

if len(CONTROL_SAMPLES) < 2 or len(TEST_SAMPLES) < 2:
    raise ValueError(
        "SnakeMicroC currently requires at least two biological samples "
        "per condition for differential analyses."
    )

CHROMSIZES = f"{RESULTS}/reference/chrom.sizes"
MAIN_VIEW = f"{RESULTS}/reference/main_chromosomes.view.tsv"
AUTOSOMES_VIEW = f"{RESULTS}/reference/autosomes.view.tsv"

PAIR = f"{RESULTS}/pairs/{{sample}}/{{sample}}.nodups.pairs.gz"
STATS = f"{RESULTS}/pairs/{{sample}}/{{sample}}.stats.txt"
SCALING = f"{RESULTS}/qc/scaling/{{sample}}.scaling.tsv"
QC_COOL = f"{RESULTS}/qc/maps/{{sample}}.1Mb.cool"
MCOOL = f"{RESULTS}/mcool/{{sample}}.mcool"

BASE_RES = int(config["contact_maps"]["base_resolution"])
ZOOM_RES = [int(x) for x in config["contact_maps"]["resolutions"]]
ZOOM_RES_CSV = ",".join(str(x) for x in ZOOM_RES)
QC_RES = int(config["qc"]["qc_map_resolution"])
COMP_RES = int(config["compartments"]["primary_resolution"])
INS_RES = int(config["boundaries"]["resolution"])
INS_WIN = int(config["boundaries"]["primary_window"])

INS_WINDOWS = [
    int(x)
    for x in config["boundaries"]["windows"]
]

INS_WINDOWS_STR = " ".join(
    str(x)
    for x in INS_WINDOWS
)

BOUNDARY_THRESHOLD = str(
    config["boundaries"]["threshold_method"]
)
HICREP_RES = int(config["reproducibility"]["resolution"])


def sample_r1(wc):
    return config["samples"][wc.sample]["r1"]


def sample_r2(wc):
    return config["samples"][wc.sample]["r2"]


# Deliberately no default all-target. Run `snakemake ... qc` first.

rule qc:
    input:
        summary=f"{RESULTS}/qc/qc_summary.tsv",
        status=f"{RESULTS}/qc/qc_status.txt",
        summary_pdf=f"{RESULTS}/qc/qc_summary.pdf",
        scaling_pdf=f"{RESULTS}/qc/scaling_curves.pdf",
        scaling_tsv=f"{RESULTS}/qc/scaling_curves.tsv",
        maps_pdf=f"{RESULTS}/qc/contact_maps_1Mb.pdf",
        corr_tsv=f"{RESULTS}/qc/contact_map_correlation_1Mb.tsv",
        corr_pdf=f"{RESULTS}/qc/contact_map_correlation_1Mb.pdf",
        complexity_tsv=f"{RESULTS}/qc/library_complexity.tsv",
        complexity_pdf=f"{RESULTS}/qc/library_complexity.pdf",
        complexity_status=f"{RESULTS}/qc/library_complexity_status.txt"


rule downstream:
    input:
        expand(MCOOL, sample=SAMPLES),
        f"{RESULTS}/reproducibility/hicrep_SCC_long.tsv",
        f"{RESULTS}/reproducibility/hicrep_SCC_matrix.tsv",
        f"{RESULTS}/structural/compartments_clone_effects.tsv.gz",
        f"{RESULTS}/structural/insulation_clone_effects.tsv.gz",
        f"{RESULTS}/contacts/differential_contacts50_all.tsv.gz",
        f"{RESULTS}/contacts/differential_contacts50_core.tsv",
        f"{RESULTS}/contacts/differential_contacts50_summary.tsv",
        f"{RESULTS}/loops/differential_loops_all.tsv.gz",
        f"{RESULTS}/loops/differential_loops_core.tsv",
        f"{RESULTS}/loops/differential_loop_summary.tsv",



rule prepare_reference:
    input:
        fai=config["reference"]["fai"]
    output:
        chromsizes=CHROMSIZES,
        main_view=MAIN_VIEW,
        autosomes_view=AUTOSOMES_VIEW
    conda:
        PROCESSING_ENV
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/reference
        python {SCRIPTS}/prepare_reference.py \
          --fai {input.fai} \
          --chrom-sizes {output.chromsizes} \
          --main-view {output.main_view} \
          --autosomes-view {output.autosomes_view}
        """


rule process_pairs:
    input:
        r1=sample_r1,
        r2=sample_r2,
        chromsizes=CHROMSIZES,
        fasta=config["reference"]["fasta"]
    output:
        pairs=PAIR,
        stats=STATS
    log:
        f"{RESULTS}/logs/{{sample}}.process_pairs.log"
    threads:
        int(config["processing"]["threads"])
    params:
        io_threads=int(config["processing"]["io_threads"]),
        mapq=int(config["processing"]["mapq"]),
        walks=config["processing"]["walks_policy"],
        gap=int(config["processing"]["max_inter_align_gap"]),
        sort_memory=config["processing"]["sort_memory"],
        tmp=lambda wc: os.path.join(TMPDIR, wc.sample)
    conda:
        PROCESSING_ENV
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output.pairs})" "$(dirname {log})" "{params.tmp}"
        rm -f "{output.pairs}.tmp.gz" "{output.stats}.tmp"

        (
          bwa mem -5SP -T0 -t {threads} {input.fasta} {input.r1} {input.r2} \
          | pairtools parse \
              --min-mapq {params.mapq} \
              --walks-policy {params.walks} \
              --max-inter-align-gap {params.gap} \
              --nproc-in {params.io_threads} \
              --nproc-out {params.io_threads} \
              --chroms-path {input.chromsizes} \
          | pairtools sort \
              --tmpdir {params.tmp} \
              --nproc {threads} \
              --memory {params.sort_memory} \
          | pairtools dedup \
              --nproc-in {params.io_threads} \
              --nproc-out {params.io_threads} \
              --output-stats "{output.stats}.tmp" \
          | pairtools split \
              --nproc-in {params.io_threads} \
              --nproc-out {params.io_threads} \
              --output-pairs "{output.pairs}.tmp.gz"
        ) 2> {log}

        mv "{output.stats}.tmp" "{output.stats}"
        mv "{output.pairs}.tmp.gz" "{output.pairs}"
        rm -rf "{params.tmp}"/*
        """


rule pairtools_scaling:
    input:
        pairs=PAIR,
        view=MAIN_VIEW
    output:
        SCALING
    threads:
        int(config["processing"]["io_threads"])
    conda:
        PROCESSING_ENV
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})"
        pairtools scaling \
          --view {input.view} \
          --nproc-in {threads} \
          -o {output} \
          {input.pairs}
        """


rule summarize_qc:
    input:
        stats=expand(STATS, sample=SAMPLES)
    output:
        tsv=f"{RESULTS}/qc/qc_summary.tsv",
        pdf=f"{RESULTS}/qc/qc_summary.pdf",
        status=f"{RESULTS}/qc/qc_status.txt"
    conda:
        PROCESSING_ENV
    params:
        samples=" ".join(SAMPLES),
        conditions=" ".join(CONDITIONS),
        min_nodup=float(config["qc"]["deep_min_nodup_pairs"]),
        min_cis=float(config["qc"]["min_cis_ge_1kb_fraction"]),
        recommended=float(config["qc"]["recommended_total_pairs"])
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/qc
        python {SCRIPTS}/summarize_qc.py \
          --stats {input.stats} \
          --samples {params.samples} \
          --conditions {params.conditions} \
          --min-nodup {params.min_nodup} \
          --min-cis1kb-frac {params.min_cis} \
          --recommended-total {params.recommended} \
          --out-tsv {output.tsv} \
          --out-pdf {output.pdf} \
          --out-status {output.status}
        """


rule plot_scaling:
    input:
        expand(SCALING, sample=SAMPLES)
    output:
        pdf=f"{RESULTS}/qc/scaling_curves.pdf",
        tsv=f"{RESULTS}/qc/scaling_curves.tsv"
    conda:
        PROCESSING_ENV
    params:
        samples=" ".join(SAMPLES),
        control_samples=" ".join(CONTROL_SAMPLES),
        test_samples=" ".join(TEST_SAMPLES),
        insulation_window=INS_WIN
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/plot_scaling.py \
          --inputs {input} \
          --samples {params.samples} \
          --out-pdf {output.pdf} \
          --out-tsv {output.tsv}
        """


rule make_qc_cool:
    input:
        pairs=PAIR,
        chromsizes=CHROMSIZES
    output:
        temp(QC_COOL)
    threads:
        int(config["contact_maps"]["balance_threads"])
    conda:
        DOWNSTREAM_ENV
    params:
        res=QC_RES,
        assembly=config["reference"]["assembly"],
        ignore_diags=int(config["contact_maps"]["ignore_diags"])
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})"
        python -m cooler cload pairs \
          --assembly {params.assembly} \
          -c1 2 -p1 3 -c2 4 -p2 5 \
          {input.chromsizes}:{params.res} \
          {input.pairs} \
          {output}
        python -m cooler balance -p {threads} --ignore-diags {params.ignore_diags} {output}
        """


rule plot_qc_contact_maps:
    input:
        expand(QC_COOL, sample=SAMPLES)
    output:
        f"{RESULTS}/qc/contact_maps_1Mb.pdf"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES)
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/plot_contact_maps_multisample.py \
          --cools {input} \
          --samples {params.samples} \
          --out-pdf {output}
        """


