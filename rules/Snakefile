        r"""
        set -euo pipefail
        python {SCRIPTS}/plot_sample_correlation.py \
          --cools {input} \
          --samples {params.samples} \
          --out-tsv {output.tsv} \
          --out-pdf {output.pdf}
        """


rule make_base_cool:
    input:
        pairs=PAIR,
        chromsizes=CHROMSIZES
    output:
        temp(f"{RESULTS}/mcool/tmp/{{sample}}.{BASE_RES}.cool")
    conda:
        DOWNSTREAM_ENV
    params:
        res=BASE_RES,
        assembly=config["reference"]["assembly"]
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})"
        python -m cooler cload pairs \
          --assembly {params.assembly} \
          -c1 2 -p1 3 -c2 4 -p2 5 \
          {input.chromsizes}:{params.res} \
          {input.pairs} \
          {output}
        """


rule make_mcool:
    input:
        f"{RESULTS}/mcool/tmp/{{sample}}.{BASE_RES}.cool"
    output:
        MCOOL
    threads:
        int(config["contact_maps"]["balance_threads"])
    conda:
        DOWNSTREAM_ENV
    params:
        resolutions=ZOOM_RES_CSV,
        ignore_diags=int(config["contact_maps"]["ignore_diags"])
    shell:
        r"""
        set -euo pipefail
        mkdir -p "$(dirname {output})"
        python -m cooler zoomify \
          -p {threads} \
          -r {params.resolutions} \
          --balance \
          --balance-args '--nproc {threads} --ignore-diags {params.ignore_diags}' \
          -o {output} \
          {input}
        """


rule hicrep_reproducibility:
    input:
        mcools=expand(MCOOL, sample=SAMPLES),
        view=AUTOSOMES_VIEW
    output:
        long=f"{RESULTS}/reproducibility/hicrep_SCC_long.tsv",
        matrix=f"{RESULTS}/reproducibility/hicrep_SCC_matrix.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        resolution=HICREP_RES,
        h=int(config["reproducibility"]["hicrep_h"]),
        maxdist=int(config["reproducibility"]["hicrep_max_distance"])
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/reproducibility
        python {SCRIPTS}/run_hicrep.py \
          --mcools {input.mcools} \
          --samples {params.samples} \
          --view {input.view} \
          --resolution {params.resolution} \
          --h {params.h} \
          --max-distance {params.maxdist} \
          --out-long {output.long} \
          --out-matrix {output.matrix}
        """


rule compartment_bins:
    input:
        MCOOL.replace("{sample}", SAMPLES[0])
    output:
        f"{RESULTS}/reference/bins.{COMP_RES}.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        res=COMP_RES
    shell:
        r"""
        set -euo pipefail
        cooler dump --header -t bins '{input}::/resolutions/{params.res}' \
          | cut -f1-3 > {output}
        """


rule gc_track:
    input:
        bins=f"{RESULTS}/reference/bins.{COMP_RES}.tsv",
        fasta=config["reference"]["fasta"]
    output:
        f"{RESULTS}/reference/gc.{COMP_RES}.tsv"
    conda:
        DOWNSTREAM_ENV
    shell:
        r"""
        set -euo pipefail
        cooltools genome gc {input.bins} {input.fasta} > {output}
        """


rule compartments:
    input:
        mcool=MCOOL,
        gc=f"{RESULTS}/reference/gc.{COMP_RES}.tsv",
        view=MAIN_VIEW
    output:
        lam=f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.lam.txt",
        vecs=f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.vecs.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        res=COMP_RES,
        prefix=lambda wc: f"{RESULTS}/structural/compartments/{wc.sample}.{COMP_RES}"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/structural/compartments
        cooltools eigs-cis \
          --view {input.view} \
          --phasing-track {input.gc} \
          --n-eigs 1 \
          -o {params.prefix} \
          '{input.mcool}::/resolutions/{params.res}'
        """


rule insulation:
    input:
        cool=f"{RESULTS}/loops/cool/{{sample}}.{LOOP_RES}.cool",
        view=MAIN_VIEW
    output:
        f"{RESULTS}/structural/insulation/{{sample}}.{INS_RES}.{INS_WIN}.tsv"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    params:
        windows=INS_WINDOWS_STR,
        threshold=BOUNDARY_THRESHOLD
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/structural/insulation

        cooltools insulation \
          --view {input.view} \
          -p {threads} \
          --threshold {params.threshold} \
          --append-raw-scores \
          --clr-weight-name weight \
          -o {output} \
          {input.cool} \
          {params.windows}
        """


rule compare_structural_tracks:
    input:
        e1=expand(f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.vecs.tsv", sample=SAMPLES),
        ins=expand(f"{RESULTS}/structural/insulation/{{sample}}.{INS_RES}.{INS_WIN}.tsv", sample=SAMPLES)
    output:
        comp=f"{RESULTS}/structural/compartments_clone_effects.tsv.gz",
        ins=f"{RESULTS}/structural/insulation_clone_effects.tsv.gz"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        control_samples=" ".join(CONTROL_SAMPLES),
        test_samples=" ".join(TEST_SAMPLES),
        insulation_window=INS_WIN
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/compare_structural_tracks.py \
          --e1 {input.e1} \
          --insulation {input.ins} \
          --samples {params.samples} \
          --control-samples {params.control_samples} \
          --test-samples {params.test_samples} \
          --insulation-window {params.insulation_window} \
          --out-compartments {output.comp} \
          --out-insulation {output.ins}
        """


# ============================================================
# DIFFERENTIAL CONTACTS
# ============================================================

rule contact50_counts:
    input:
        mcools=expand(
            MCOOL,
            sample=SAMPLES
        ),
        view=AUTOSOMES_VIEW
    output:
        counts=f"{RESULTS}/contacts/contact50_condition_blind_counts.tsv.gz",
        summary=f"{RESULTS}/contacts/contact50_prefilter_summary.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=",".join(SAMPLES),
        mcool_pattern=lambda wildcards: MCOOL,
        res=CONTACT_RES,
        mindist=int(
            config["contacts"]["min_distance_bp"]
        ),
        maxdist=int(
            config["contacts"]["max_distance_bp"]
        ),
        mintotal=int(
            config["contacts"]["prefilter_min_total_count"]
        ),
        minnonzero=int(
            config["contacts"]["prefilter_min_nonzero_samples"]
        )
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/contacts

        python {SCRIPTS}/build_contact50_counts.py \
          --samples '{params.samples}' \
          --resolution {params.res} \
          --min-distance-bp {params.mindist} \
          --max-distance-bp {params.maxdist} \
          --prefilter-min-total-count {params.mintotal} \
          --prefilter-min-nonzero-samples {params.minnonzero} \
          --mcool-pattern '{params.mcool_pattern}' \
          --autosomes-view {input.view} \
          --outdir {RESULTS}/contacts
        """


rule differential_contacts50:
    input:
        rules.contact50_counts.output.counts
    output:
        all=f"{RESULTS}/contacts/differential_contacts50_all.tsv.gz",
        core=f"{RESULTS}/contacts/differential_contacts50_core.tsv",
        summary=f"{RESULTS}/contacts/differential_contacts50_summary.tsv",
        filtering=f"{RESULTS}/contacts/contact50_edgeR_filtering_summary.tsv",
        pdf=f"{RESULTS}/contacts/EXP_independent_contacts50_volcano.pdf"
    conda:
        R_ENV
    params:
        controls=",".join(CONTROL_SAMPLES),
        tests=",".join(TEST_SAMPLES),
        fdr=float(
            config["contacts"]["differential_fdr"]
        ),
        lfc=float(
            config["contacts"]["differential_min_abs_log2fc"]
        )
    shell:
        r"""
        set -euo pipefail

        Rscript {SCRIPTS}/differential_contacts50_edgeR.R \
          --input {input} \
          --outdir {RESULTS}/contacts \
          --fdr {params.fdr} \
          --min-abs-log2fc {params.lfc} \
          --control-samples '{params.controls}' \
          --test-samples '{params.tests}'
        """


# ============================================================
# CONDITION-BLIND LOOP CALLING
# ============================================================

rule loop_cool:
    input:
        pairs=PAIR,
        chroms=CHROMSIZES
    output:
        f"{RESULTS}/loops/cool/{{sample}}.{LOOP_RES}.cool"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    params:
        res=LOOP_RES
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname {output})"

        cooler cload pairs \
          -c1 2 -p1 3 \
          -c2 4 -p2 5 \
          {input.chroms}:{params.res} \
          {input.pairs} \
          {output}

        cooler balance \
          -p {threads} \
          --ignore-diags {IGNORE_DIAGS} \
          {output}
        """


rule pooled_loop_cool:
    input:
        expand(
            f"{RESULTS}/loops/cool/{{sample}}.{LOOP_RES}.cool",
            sample=SAMPLES
        )
    output:
        f"{RESULTS}/loops/pooled_all_samples.{LOOP_RES}.cool"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/loops
        rm -f {output}.tmp.cool

        cooler merge \
          {output}.tmp.cool \
          {input}

        mv \
          {output}.tmp.cool \
          {output}

        cooler balance \
          -p {threads} \
          --ignore-diags {IGNORE_DIAGS} \
          {output}
        """


rule pooled_loop_expected:
    input:
        cool=rules.pooled_loop_cool.output,
        view=MAIN_VIEW
    output:
        f"{RESULTS}/loops/pooled_all_samples.expected_cis.{LOOP_RES}.tsv"
    threads:
        THREADS
    conda:
        DOWNSTREAM_ENV
    shell:
        r"""
        set -euo pipefail

        cooltools expected-cis \
          -p {threads} \
          --view {input.view} \
          -o {output} \
          {input.cool}
        """


rule pooled_loop_dots:
    input:
        cool=rules.pooled_loop_cool.output,
        expected=rules.pooled_loop_expected.output,
        view=MAIN_VIEW
    output:
        f"{RESULTS}/loops/pooled_all_samples.dots.tsv"
    threads:
        THREADS
    conda:
        DOWNSTREAM_ENV
    params:
        maxdist=int(
            config["loops"]["max_distance_bp"]
        ),
        fdr=float(
            config["loops"]["pooled_dot_fdr"]
        )
    shell:
        r"""
        set -euo pipefail

        cooltools dots \
          -p {threads} \
          --view {input.view} \
          --max-loci-separation {params.maxdist} \
          --tile-size {params.maxdist} \
          --fdr {params.fdr} \
          -o {output} \
          {input.cool} \
          {input.expected}
        """


rule loop_counts:
    input:
        dots=rules.pooled_loop_dots.output,
        cools=expand(
            f"{RESULTS}/loops/cool/{{sample}}.{LOOP_RES}.cool",
            sample=SAMPLES
        )
    output:
        counts=f"{RESULTS}/loops/pooled_loop_candidates_counts.tsv.gz",
        bedpe=f"{RESULTS}/loops/pooled_loop_candidates.bedpe.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=",".join(SAMPLES),
        cool_pattern=lambda wildcards: f"{RESULTS}/loops/cool/{{sample}}.{LOOP_RES}.cool",
        res=LOOP_RES,
        mindist=int(
            config["loops"]["min_distance_bp"]
        ),
        maxdist=int(
            config["loops"]["max_distance_bp"]
        ),
        radius=int(
            config["loops"]["quant_radius_bins"]
        )
    shell:
        r"""
        set -euo pipefail

        python {SCRIPTS}/build_loop_counts.py \
          --samples '{params.samples}' \
          --resolution {params.res} \
          --min-distance-bp {params.mindist} \
          --max-distance-bp {params.maxdist} \
          --quant-radius-bins {params.radius} \
          --dots {input.dots} \
          --cool-pattern '{params.cool_pattern}' \
          --outdir {RESULTS}/loops
        """


rule differential_loops:
    input:
        rules.loop_counts.output.counts
    output:
        all=f"{RESULTS}/loops/differential_loops_all.tsv.gz",
        core=f"{RESULTS}/loops/differential_loops_core.tsv",
        summary=f"{RESULTS}/loops/differential_loop_summary.tsv",
        filtering=f"{RESULTS}/loops/loop_filtering_summary.tsv",
        pdf=f"{RESULTS}/loops/EXP_differential_loops_volcano.pdf"
    conda:
        R_ENV
    params:
        controls=",".join(CONTROL_SAMPLES),
        tests=",".join(TEST_SAMPLES),
        fdr=float(
            config["loops"]["differential_fdr"]
        ),
        lfc=float(
            config["loops"]["differential_min_abs_log2fc"]
        )
    shell:
        r"""
        set -euo pipefail

        Rscript {SCRIPTS}/differential_loops_edgeR.R \
          --input {input} \
          --outdir {RESULTS}/loops \
          --fdr {params.fdr} \
          --min-abs-log2fc {params.lfc} \
          --control-samples '{params.controls}' \
          --test-samples '{params.tests}'
        """


rule library_complexity:
    input:
        stats=expand(
            STATS,
            sample=SAMPLES
        )
    output:
        tsv=f"{RESULTS}/qc/library_complexity.tsv",
        pdf=f"{RESULTS}/qc/library_complexity.pdf",
        status=f"{RESULTS}/qc/library_complexity_status.txt"
    conda:
        PROCESSING_ENV
    params:
        samples=" ".join(SAMPLES),
        conditions=" ".join(CONDITIONS),
        multipliers=" ".join(
            str(x)
            for x in config[
                "library_complexity"
            ]["depth_multipliers"]
        ),
        warning=float(
            config[
                "library_complexity"
            ]["warning_multiplier"]
        ),
        min_unique=float(
            config[
                "library_complexity"
            ][
                "min_marginal_unique_fraction"
            ]
        )
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/qc

        python {SCRIPTS}/library_complexity.py \
          --stats {input.stats} \
          --samples {params.samples} \
          --conditions {params.conditions} \
          --multipliers {params.multipliers} \
          --warning-multiplier {params.warning} \
          --min-marginal-unique-fraction {params.min_unique} \
          --out-tsv {output.tsv} \
          --out-pdf {output.pdf} \
          --out-status {output.status}
        """


rule provenance_processing_versions:
