    input:
        expand(MCOOL, sample=SAMPLES)
    output:
        f"{RESULTS}/qc/contact_maps_1Mb.pdf"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        cool_uris=QC_MCOOL_URIS
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/plot_contact_maps_multisample.py \
          --cools {params.cool_uris} \
          --samples {params.samples} \
          --out-pdf {output}
        """


rule qc_correlation:
    input:
        expand(MCOOL, sample=SAMPLES)
    output:
        tsv=f"{RESULTS}/qc/contact_map_correlation_1Mb.tsv",
        pdf=f"{RESULTS}/qc/contact_map_correlation_1Mb.pdf"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        cool_uris=QC_MCOOL_URIS
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/plot_sample_correlation.py \
          --cools {params.cool_uris} \
          --samples {params.samples} \
          --out-tsv {output.tsv} \
          --out-pdf {output.pdf}
        """


# A single producer for the .mcool keeps the DAG independent of
# deleted 25-kb temporary inputs. All temporary files are private to the job.
# For a verified legacy adoption, the .mcool files are external inputs; no
# rule is defined that could accidentally overwrite them.
if not REUSE_VERIFIED_MCOOLS:
    rule make_mcool:
        input:
            pairs=PAIR,
            chromsizes=CHROMSIZES
        output:
            MCOOL
        threads:
            int(config["contact_maps"]["balance_threads"])
        conda:
            DOWNSTREAM_ENV
        params:
            base_res=BASE_RES,
            assembly=config["reference"]["assembly"],
            resolutions=ZOOM_RES_CSV,
            ignore_diags=IGNORE_DIAGS,
            scratch=TMPDIR
        shell:
            r"""
            set -euo pipefail
            mkdir -p "{params.scratch}" "$(dirname {output})"
            scratch=$(mktemp -d "{params.scratch}/microc_mcool_XXXXXX")
            trap 'rm -f "$scratch/base.cool" "$scratch/output.mcool"; rmdir "$scratch" 2>/dev/null || true' EXIT
            python -m cooler cload pairs \
              --assembly {params.assembly} \
              -c1 2 -p1 3 -c2 4 -p2 5 \
              {input.chromsizes}:{params.base_res} \
              {input.pairs} \
              "$scratch/base.cool"
            python -m cooler zoomify \
              -p {threads} \
              -r {params.resolutions} \
              --balance \
              --balance-args '--nproc {threads} --ignore-diags {params.ignore_diags}' \
              -o "$scratch/output.mcool" \
              "$scratch/base.cool"
            mv "$scratch/output.mcool" {output}
            """


rule hicrep_reproducibility:
    input:
        mcools=expand(MCOOL, sample=SAMPLES),
        view=AUTOSOMES_VIEW
    output:
        long=f"{RESULTS}/reproducibility/hicrep_SCC_long.tsv",
        matrix=f"{RESULTS}/reproducibility/hicrep_SCC_matrix.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        resolution=HICREP_RES,
        h=int(config["reproducibility"]["hicrep_h"]),
        maxdist=int(config["reproducibility"]["hicrep_max_distance"])
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/reproducibility
        python {SCRIPTS}/run_hicrep.py \
          --mcools {input.mcools} \
          --samples {params.samples} \
          --view {input.view} \
          --resolution {params.resolution} \
          --h {params.h} \
          --max-distance {params.maxdist} \
          --out-long {output.long} \
          --out-matrix {output.matrix}
        """


rule compartment_bins:
    input:
        MCOOL.replace("{sample}", SAMPLES[0])
    output:
        f"{RESULTS}/reference/bins.{COMP_RES}.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        res=COMP_RES
    shell:
        r"""
        set -euo pipefail
        cooler dump --header -t bins '{input}::/resolutions/{params.res}' \
          | cut -f1-3 > {output}
        """


rule gc_track:
    input:
        bins=f"{RESULTS}/reference/bins.{COMP_RES}.tsv",
        fasta=config["reference"]["fasta"]
    output:
        f"{RESULTS}/reference/gc.{COMP_RES}.tsv"
    conda:
        DOWNSTREAM_ENV
    shell:
        r"""
        set -euo pipefail
        cooltools genome gc {input.bins} {input.fasta} > {output}
        """


rule compartments:
    input:
        mcool=MCOOL,
        gc=f"{RESULTS}/reference/gc.{COMP_RES}.tsv",
        view=MAIN_VIEW
    output:
        lam=f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.lam.txt",
        vecs=f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.vecs.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        res=COMP_RES,
        prefix=lambda wc: f"{RESULTS}/structural/compartments/{wc.sample}.{COMP_RES}"
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/structural/compartments
        cooltools eigs-cis \
          --view {input.view} \
          --phasing-track {input.gc} \
          --n-eigs 1 \
          -o {params.prefix} \
          '{input.mcool}::/resolutions/{params.res}'
        """


# If the required insulation resolution differs from the loop-calling
# resolution, a dedicated matrix is necessary. Otherwise INS_COOL points
# directly to the existing 10-kb loop cooler (and no duplicate is created).
if INS_RES != LOOP_RES:
    rule insulation_cool:
        input:
            pairs=PAIR,
            chroms=CHROMSIZES
        output:
            INS_COOL
        threads:
            BALANCE_THREADS
        conda:
            DOWNSTREAM_ENV
        params:
            res=INS_RES
        shell:
            r"""
            set -euo pipefail
            mkdir -p "$(dirname {output})"
            cooler cload pairs \
              -c1 2 -p1 3 \
              -c2 4 -p2 5 \
              {input.chroms}:{params.res} \
              {input.pairs} \
              {output}
            cooler balance \
              -p {threads} \
              --ignore-diags {IGNORE_DIAGS} \
              {output}
            """


rule insulation:
    input:
        cool=INS_COOL,
        view=MAIN_VIEW
    output:
        f"{RESULTS}/structural/insulation/{{sample}}.{INS_RES}.{INS_WIN}.tsv"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    params:
        windows=INS_WINDOWS_STR,
        threshold=BOUNDARY_THRESHOLD
    shell:
        r"""
        set -euo pipefail
        mkdir -p {RESULTS}/structural/insulation
        cooltools insulation \
          --view {input.view} \
          -p {threads} \
          --threshold {params.threshold} \
          --append-raw-scores \
          --clr-weight-name weight \
          -o {output} \
          {input.cool} \
          {params.windows}
        """


rule compare_structural_tracks:
    input:
        e1=expand(f"{RESULTS}/structural/compartments/{{sample}}.{COMP_RES}.cis.vecs.tsv", sample=SAMPLES),
        ins=expand(f"{RESULTS}/structural/insulation/{{sample}}.{INS_RES}.{INS_WIN}.tsv", sample=SAMPLES)
    output:
        comp=f"{RESULTS}/structural/compartments_clone_effects.tsv.gz",
        ins=f"{RESULTS}/structural/insulation_clone_effects.tsv.gz"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=" ".join(SAMPLES),
        control_samples=" ".join(CONTROL_SAMPLES),
        test_samples=" ".join(TEST_SAMPLES),
        insulation_window=INS_WIN
    shell:
        r"""
        set -euo pipefail
        python {SCRIPTS}/compare_structural_tracks.py \
          --e1 {input.e1} \
          --insulation {input.ins} \
          --samples {params.samples} \
          --control-samples {params.control_samples} \
          --test-samples {params.test_samples} \
          --insulation-window {params.insulation_window} \
          --out-compartments {output.comp} \
          --out-insulation {output.ins}
        """


# ============================================================
# DIFFERENTIAL CONTACTS
# ============================================================

rule contact50_counts:
    input:
        mcools=expand(
            MCOOL,
            sample=SAMPLES
        ),
        view=AUTOSOMES_VIEW
    output:
        counts=f"{RESULTS}/contacts/contact50_condition_blind_counts.tsv.gz",
        summary=f"{RESULTS}/contacts/contact50_prefilter_summary.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=",".join(SAMPLES),
        mcool_pattern=lambda wildcards: MCOOL,
        res=CONTACT_RES,
        mindist=int(
            config["contacts"]["min_distance_bp"]
        ),
        maxdist=int(
            config["contacts"]["max_distance_bp"]
        ),
        mintotal=int(
            config["contacts"]["prefilter_min_total_count"]
        ),
        minnonzero=int(
            config["contacts"]["prefilter_min_nonzero_samples"]
        )
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/contacts

        python {SCRIPTS}/build_contact50_counts.py \
          --samples '{params.samples}' \
          --resolution {params.res} \
          --min-distance-bp {params.mindist} \
          --max-distance-bp {params.maxdist} \
          --prefilter-min-total-count {params.mintotal} \
          --prefilter-min-nonzero-samples {params.minnonzero} \
          --mcool-pattern '{params.mcool_pattern}' \
          --autosomes-view {input.view} \
          --outdir {RESULTS}/contacts
        """


rule differential_contacts50:
    input:
        rules.contact50_counts.output.counts
    output:
        all=f"{RESULTS}/contacts/differential_contacts50_all.tsv.gz",
        core=f"{RESULTS}/contacts/differential_contacts50_core.tsv",
        summary=f"{RESULTS}/contacts/differential_contacts50_summary.tsv",
        filtering=f"{RESULTS}/contacts/contact50_edgeR_filtering_summary.tsv",
        pdf=f"{RESULTS}/contacts/EXP_independent_contacts50_volcano.pdf"
    conda:
        R_ENV
    params:
        controls=",".join(CONTROL_SAMPLES),
        tests=",".join(TEST_SAMPLES),
        fdr=float(
            config["contacts"]["differential_fdr"]
        ),
        lfc=float(
            config["contacts"]["differential_min_abs_log2fc"]
        ),
        mincount=int(config["contacts"].get("edgeR_min_count", 5)),
        mintotal=int(config["contacts"].get("edgeR_min_total_count", 20))
    shell:
        r"""
        set -euo pipefail

        Rscript {SCRIPTS}/differential_contacts50_edgeR.R \
          --input {input} \
          --outdir {RESULTS}/contacts \
          --fdr {params.fdr} \
          --min-abs-log2fc {params.lfc} \
          --min-count {params.mincount} \
          --min-total-count {params.mintotal} \
          --control-samples '{params.controls}' \
          --test-samples '{params.tests}'
        """


# ============================================================
# CONDITION-BLIND LOOP CALLING - MUSTACHE
#
# Primary analysis:
#   10 kb
#
# High-resolution secondary analysis:
#   5 kb, run separately by changing primary_resolution.
#
# Candidate discovery is condition-blind.
# Differential quantification uses full-depth per-sample
# raw contact counts.
# ============================================================

rule loop_cool:
    input:
        pairs=PAIR,
        chroms=CHROMSIZES
    output:
        f"{LOOPS_DIR}/cool/{{sample}}.cool"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    params:
        res=LOOP_RES
    shell:
        r"""
        set -euo pipefail

        mkdir -p "$(dirname {output})"

        cooler cload pairs \
          -c1 2 -p1 3 \
          -c2 4 -p2 5 \
          {input.chroms}:{params.res} \
          {input.pairs} \
          {output}

        cooler balance \
          -p {threads} \
          --ignore-diags {IGNORE_DIAGS} \
          {output}
        """


rule pooled_loop_cool:
    input:
        expand(
            f"{LOOPS_DIR}/cool/{{sample}}.cool",
            sample=SAMPLES
        )
    output:
        f"{LOOPS_DIR}/pooled_all_samples.cool"
    threads:
        BALANCE_THREADS
    conda:
        DOWNSTREAM_ENV
    shell:
        r"""
        set -euo pipefail

        mkdir -p {LOOPS_DIR}

        rm -f {output}.tmp.cool

        cooler merge \
          {output}.tmp.cool \
          {input}

        mv \
          {output}.tmp.cool \
          {output}

        cooler balance \
          -p {threads} \
          --ignore-diags {IGNORE_DIAGS} \
          {output}
        """


rule pooled_loop_mustache:
    input:
        cool=rules.pooled_loop_cool.output
    output:
        loops=f"{LOOPS_DIR}/pooled_all_samples.mustache.raw.tsv",
        parameters=f"{LOOPS_DIR}/mustache_parameters.tsv",
        versions=f"{LOOPS_DIR}/mustache_environment_versions.txt"
    threads:
        int(
            config.get(
                "loops",
                {}
            ).get(
                "mustache_threads",
                12
            )
        )
    conda:
        MUSTACHE_ENV
    params:
        res=LOOP_RES,
        pt=float(
            config.get(
                "loops",
                {}
            ).get(
                "mustache_pvalue_threshold",
                0.1
            )
        ),
        st=float(
            config.get(
                "loops",
                {}
            ).get(
                "mustache_sparsity_threshold",
                0.88
            )
        )
    shell:
        r"""
        set -euo pipefail

        mkdir -p {LOOPS_DIR}

        mustache \
          -f {input.cool} \
          -r {params.res} \
          -pt {params.pt} \
          -st {params.st} \
          -p {threads} \
          -o {output.loops}

        printf \
          "parameter\tvalue\ncaller\tMustache\nresolution_bp\t%s\npvalue_threshold\t%s\nsparsity_threshold\t%s\nthreads\t%s\n" \
          "{params.res}" \
          "{params.pt}" \
          "{params.st}" \
          "{threads}" \
          > {output.parameters}

        python -m pip freeze \
          | sort \
          > {output.versions}
        """


rule canonical_loop_candidates:
    input:
        loops=rules.pooled_loop_mustache.output.loops,
        view=MAIN_VIEW
    output:
        f"{LOOPS_DIR}/pooled_loop_candidates.bedpe.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        res=LOOP_RES,
        mindist=int(
            config["loops"]["min_distance_bp"]
        ),
        maxdist=int(
            config["loops"]["max_distance_bp"]
        )
    shell:
        r"""
        set -euo pipefail

        python {SCRIPTS}/mustache_to_bedpe.py \
          --input {input.loops} \
          --output {output} \
          --view {input.view} \
          --resolution {params.res} \
          --min-distance-bp {params.mindist} \
          --max-distance-bp {params.maxdist}
        """


rule loop_counts:
    input:
        loops=rules.canonical_loop_candidates.output,
        cools=expand(
            f"{LOOPS_DIR}/cool/{{sample}}.cool",
            sample=SAMPLES
        )
    output:
        counts=f"{LOOPS_DIR}/pooled_loop_candidates_counts.tsv.gz",
        libraries=f"{LOOPS_DIR}/loop_library_sizes.tsv"
    conda:
        DOWNSTREAM_ENV
    params:
        samples=",".join(SAMPLES),
        cool_pattern=lambda wildcards:
            f"{LOOPS_DIR}/cool/{{sample}}.cool",
        res=LOOP_RES,
        radius=int(
            config["loops"]["quant_radius_bins"]
        )
    shell:
        r"""
        set -euo pipefail

        python {SCRIPTS}/build_loop_counts.py \
          --samples '{params.samples}' \
          --resolution {params.res} \
          --quant-radius-bins {params.radius} \
          --loops {input.loops} \
          --cool-pattern '{params.cool_pattern}' \
          --outdir {LOOPS_DIR}
        """


rule differential_loops:
    input:
        counts=rules.loop_counts.output.counts,
        libraries=rules.loop_counts.output.libraries
    output:
        all=f"{LOOPS_DIR}/differential_loops_all.tsv.gz",
        significant=f"{LOOPS_DIR}/differential_loops_FDR_effect.tsv",
        core=f"{LOOPS_DIR}/differential_loops_core.tsv",
        summary=f"{LOOPS_DIR}/differential_loop_summary.tsv",
        filtering=f"{LOOPS_DIR}/loop_filtering_summary.tsv",
        normalization=f"{LOOPS_DIR}/loop_normalization_factors.tsv",
        volcano=f"{LOOPS_DIR}/EXP_differential_loops_volcano.pdf",
        qc=f"{LOOPS_DIR}/EXP_differential_loops_QC.pdf"
    conda:
        R_ENV
    params:
        controls=",".join(
            CONTROL_SAMPLES
        ),
        tests=",".join(
            TEST_SAMPLES
        ),
        fdr=float(
            config["loops"][
                "differential_fdr"
            ]
        ),
        lfc=float(
            config["loops"][
                "differential_min_abs_log2fc"
            ]
        ),
        mincount=int(
            config.get(
                "loops",
                {}
            ).get(
                "edgeR_min_count",
                5
            )
        ),
        mintotal=int(
            config.get(
                "loops",
                {}
            ).get(
                "edgeR_min_total_count",
                15
            )
        )
    shell:
        r"""
        set -euo pipefail

        Rscript \
          {SCRIPTS}/differential_loops_edgeR.R \
          --input {input.counts} \
          --library-sizes {input.libraries} \
          --outdir {LOOPS_DIR} \
          --fdr {params.fdr} \
          --min-abs-log2fc {params.lfc} \
          --min-count {params.mincount} \
          --min-total-count {params.mintotal} \
          --control-samples '{params.controls}' \
          --test-samples '{params.tests}'
        """




rule loop_report:
    input:
        summary=rules.differential_loops.output.summary,
        filtering=rules.differential_loops.output.filtering,
        normalization=rules.differential_loops.output.normalization,
        all_results=rules.differential_loops.output.all,
        core_results=rules.differential_loops.output.core,
        library_sizes=rules.loop_counts.output.libraries,
        parameters=rules.pooled_loop_mustache.output.parameters,
        versions=rules.pooled_loop_mustache.output.versions
    output:
        md=f"{LOOPS_DIR}/MicroC_loop_analysis_report.md",
        html=f"{LOOPS_DIR}/MicroC_loop_analysis_report.html"
    conda:
        DOWNSTREAM_ENV
    params:
        res=LOOP_RES,
        fdr=float(
            config["loops"]["differential_fdr"]
        ),
        lfc=float(
            config["loops"]["differential_min_abs_log2fc"]
        ),
        control=CONTROL_CONDITION or "control",
        test=TEST_CONDITION or "test",
        radius=int(config["loops"]["quant_radius_bins"])
    shell:
        r"""
        set -euo pipefail

        python {SCRIPTS}/build_loop_report.py \
          --summary {input.summary} \
          --filtering {input.filtering} \
          --normalization {input.normalization} \
          --all-results {input.all_results} \
          --core-results {input.core_results} \
          --library-sizes {input.library_sizes} \
          --parameters {input.parameters} \
          --versions {input.versions} \
          --resolution {params.res} \
          --fdr {params.fdr} \
          --lfc {params.lfc} \
          --quant-radius {params.radius} \
          --control-label '{params.control}' \
          --test-label '{params.test}' \
          --output-md {output.md} \
          --output-html {output.html}
        """




rule methods_config:
    output:
        f"{RESULTS}/provenance/methods_resolved_config.yaml"
    params:
        configuration_sha256=CONFIG_FINGERPRINT
    run:
        import yaml

        os.makedirs(
            os.path.dirname(output[0]),
            exist_ok=True
        )

        with open(output[0], "w") as fh:
            yaml.safe_dump(
                dict(config),
                fh,
                sort_keys=False
            )


