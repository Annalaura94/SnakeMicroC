        python {SCRIPTS}/build_microc_methods.py \
          {params.compare_flag} \
          --config {input.config} \
          --pipeline-dir {PIPELINE_DIR} \
          --output-md {output.md} \
          --output-txt {output.txt}
        """



rule library_complexity:
    input:
        stats=expand(
            STATS,
            sample=SAMPLES
        )
    output:
        tsv=f"{RESULTS}/qc/library_complexity.tsv",
        pdf=f"{RESULTS}/qc/library_complexity.pdf",
        status=f"{RESULTS}/qc/library_complexity_status.txt"
    conda:
        PROCESSING_ENV
    params:
        samples=" ".join(SAMPLES),
        conditions=" ".join(CONDITIONS),
        multipliers=" ".join(
            str(x)
            for x in config[
                "library_complexity"
            ]["depth_multipliers"]
        ),
        warning=float(
            config[
                "library_complexity"
            ]["warning_multiplier"]
        ),
        min_unique=float(
            config[
                "library_complexity"
            ][
                "min_marginal_unique_fraction"
            ]
        )
    shell:
        r"""
        set -euo pipefail

        mkdir -p {RESULTS}/qc

        python {SCRIPTS}/library_complexity.py \
          --stats {input.stats} \
          --samples {params.samples} \
          --conditions {params.conditions} \
          --multipliers {params.multipliers} \
          --warning-multiplier {params.warning} \
          --min-marginal-unique-fraction {params.min_unique} \
          --out-tsv {output.tsv} \
          --out-pdf {output.pdf} \
          --out-status {output.status}
        """


